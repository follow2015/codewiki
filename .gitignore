__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/
site/

# 产物目录：不回提交（设计文稿 9.0 —— 产物走 CI artifact / 本地生成）
wiki-output/

# 外挂配置（configs/<target>.toml）：**使用方资产**，由 init 生成、使用方维护。
# 与 sync-to-deploy.sh 白名单同一口径 —— 它既不进公开仓，也不该进主仓：
# 跟踪它只会让"改了这个仓库的分析参数"混进产品提交里。
configs/*.toml

# 分析缓存（含测试夹具里被写出来的那份）：运行时产物，不入库
.codewiki/

# 本地临时工作目录（验证脚本、参考实现副本等）：不入库
.cw-tmp/

# AI 外置推理队列（ai-annotate --deferred 的 requests/answers）：运行时产物
# 里面是待问内容与逐条作答，随仓库分发既无意义、也容易带上业务代码片段
.ai-queue/

# AI 标注建议（*.suggest.toml）：reviewed 前只是候选，合并进 codewiki.toml 才算数
*.suggest.toml

# macOS 垃圾文件
.DS_Store

# 部署仓（sync-to-deploy.sh 的目标，独立 git 仓，不进主仓）
codewiki-deploy/

# 评审输入物（外部评审补丁、设计文稿、截图等）：不是产品代码，含内部上下文
archive/
