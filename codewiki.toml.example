# codewiki 配置示例（复制到项目根目录为 codewiki.toml）
# 全部段落都可缺省：不提供本文件也能跑（默认值 + 诊断提示）。
#
# 不想手写？`codewiki init --src .` 会扫描本仓库起草一份：
#   目录骨架 + 按依赖排好的层序 + 点名互相依赖/成环的层；加 `--ai` 让模型按职责归并。
#   生成的配置自带 [languages]、[analysis] exclude 与从 tsconfig 推断的 ts_aliases，
#   可直接 `codewiki analyze --config`。

[project]
name = "我的项目"
# 产物语言：影响界面固定文案（导航、章节标题、表头、SVG 标注、图表注释）与 <html lang>。
# 支持 zh / en（en-US、en_US 也认），认不出的值退回 zh —— 这个字段不影响分析结果，
# 没必要为它中断整条流水线。
# 文案表在 codewiki/render/locales/<lang>.py。加一门语言 = 新建一个表 + 在
# locales/__init__.py 的 CATALOGS 登记，**不用改任何 t() 调用点**。
# 不翻的部分：诊断消息（Diagnostic.message —— 开发者接口，code 才是稳定契约）、
# 层名 / 模块路径 / docstring / 注解内容（这些是被分析仓库的数据，不是界面文案）。
lang = "zh"

[languages]
# 解析语言白名单；不在表内的扩展名仅登记为资源文件
python = { ext = [".py"], analyzer = "ast" }
typescript = { ext = [".ts", ".tsx"], analyzer = "treesitter" }
go = { ext = [".go"], analyzer = "treesitter" }

[analysis]
# 低于该置信度的边不进宏观图
min_confidence = 0.5
# 单图节点上限，超过自动按层分包
max_nodes = 300
exclude = ["tests", "scripts"]
# TS/JS 模块别名：键是 import 里写的前缀（结尾 * = 通配，否则精确匹配），
# 值是仓库内路径前缀（用 * 承接剩余部分）。**不去读 tsconfig** —— 只认这里。
# 前端通常全用别名而不是相对路径，不配的话模块间一条边都连不上（全都算第三方）。
# ts_aliases = { "@/*" = "frontend-new/src/*", "@config" = "frontend-new/src/config/app.ts" }
# Python 包名与分析根目录名不一致时填这里（一般**不用填**：默认取 --src 的目录名，
# 不够时会按 import 统计自动推断，并记一条 ROOT_PACKAGE_INFERRED）。
# 什么时候需要：分析根**就是**包的内容目录、但导入写的是完整包路径 —— 例如 --src . 指向的
# 目录叫 `repo`，代码里却是 `from app.core import run`。若 --src 指向的是包含包的上一层
# （--src 下有 app/ 目录），保持默认即可。
# root_package = "app"

[architecture]
# 未声明任何 [[architecture.layers]] 时，是否按目录结构推断分层（默认 true）。
# 推断结果只代表"目录归类"，层序按跨层依赖排出；要带内聚度/环标注的建议请跑
# `codewiki suggest-layers`。设 false 则退回旧行为：全部模块进虚拟层 _unlayered。
# auto_layers = true
#
# 系统架构层级（用于宏观架构图）；匹配按**最长前缀优先**
[[architecture.layers]]
name = "接口层"
paths = ["app/api"]
color = "#B3E5FC"

[[architecture.layers]]
name = "服务层"
paths = ["app/services"]
color = "#C8E6C9"

[[architecture.layers]]
name = "数据层"
paths = ["app/persistence", "app/models"]
color = "#FFE0B2"

# 人工注解（AI 建议合并后也落在这里）
[[annotations]]
target = "mod::app/services/order.py"
label = "订单核心"
note = "下单主链路；并发限制见 run_order 的 Redis 锁。"

# ── 架构规则（由 `codewiki check` 求值，不影响 analyze 产物）───────────────────
# 声明"谁不许依赖谁"，让架构在 CI 里被守住，而不是只在报告里被描述。
#
# 目标写法三种：layer:<层名>（须与上面 [[architecture.layers]] 的 name 一致）
#              dir:<路径前缀>   module:<模块路径>
# 违例身份 = (规则 id, 源模块, 宿模块, 边类型)，**不含行号** —— 行号随无关改动漂移，
# 拿它当身份会让基线每天都失效，最后没人再用基线。
# 层名改了就换了一层：改层名 = 换身份，基线会整体失效，别指望它自动跟上。
[[rules]]
id = "no-api-to-persistence"       # 稳定身份：基线按它记账，改 id = 换一条新规则
kind = "forbid-dependency"
from = "layer:接口层"
to = "layer:数据层"
severity = "error"                 # error 影响退出码；warning 只进报告
reason = "接口层不得直连持久化，改走服务层"

# 环规则：scope 范围内的模块之间不许有环。环看的是**全类型**边，
# 所以这里写 edges 是无效配置（会被拒绝，而不是静默忽略）。
[[rules]]
id = "no-service-cycles"
kind = "forbid-cycle"
scope = "layer:服务层"
severity = "warning"

# 只算 import、不算调用是默认行为；要看调用边请显式写：
#   edges = ["IMPORTS", "CALLS"]
# TYPE_CHECKING 下的类型依赖默认计入但降级为 warning（规则算耦合度，
# 与"环算运行时可达性"的口径故意不同）：
#   type_only = "warn"   # warn | ignore | error

[ai]
# AI 增强总开关，三态：
#   缺省（不写这一行）—— 不干预：AI 命令是否执行由 --model / OPENAI_MODEL 决定；
#   enabled = false    —— 项目方声明"不要 AI 分析"：ai-annotate / agent / diagram /
#                         init --ai 直接退出 2（init 未显式 --ai 时降级为目录起草），
#                         操作者确实要跑时加 --force-ai（或 CODEWIKI_FORCE_AI=1）。
#                         merge-annotations 不受管：它不调模型，是人工环节；
#   enabled = true     —— 允许，但**不强制**：没有模型照样报错，端点与模型仍只认
#                         操作者（见下）。这里的 true 之所以不能"开启 AI"，是因为
#                         该文件来自被分析仓库，让它能开等于把 API Key 的去向交给它。
# analyze（纯静态）不受本字段影响：整段缺失也全功能可用。
# enabled = true
# ── 下面三项「只认操作者」──────────────────────────────────────────────────
# 本文件通常就躺在**被分析仓库**里，作者可控。若允许它决定端点和写入策略，
# hostile 仓库就能把 OPENAI_API_KEY 发往任意地址，或让 AI 建议直接合进主配置。
# 所以这三项写在文件里默认被忽略（运行时打一条 warning），请改用命令行/环境变量：
#   model      → --model       或 OPENAI_MODEL
#   base_url   → --base-url    或 OPENAI_BASE_URL
#   write_back → --write-back  （review-file / dry-run / confirm / auto）
# 自己拥有的仓库想保留文件写法：加 --trust-config，或置 CODEWIKI_TRUST_CONFIG=1。
# model = "qwen2.5-coder"
# base_url = "http://localhost:11434/v1"
# write_back = "review-file"
# 单轮 token 硬上限；超预算优雅停止并标注"未完成模块"
budget_tokens = 200000
max_retries = 2
timeout_s = 60
# 标注取前 N 个热点模块
top_n = 30
# 拓扑感知缓存键（默认开）。标注 prompt 里带着项目名 / 层名 / 人工注解，三者都来自
# 本文件：改了分层或补了注解，同一份源码该得到的答案就不同了。不把它们的指纹打进
# 缓存键，命中就等于拿旧语境作答（"我改了分层，AI 的注解还按老层说"）。
# 注解持续增长的仓库可以关掉它换取命中率，代价是可能复用旧语境的答案。
cache_include_topology = true
# L2 真实渲染校验（默认关）：`ai-diagram` 出图后除了 L1 特征校验，再用
# mermaid-cli 真渲染一次（需 Node 24 LTS + mermaid-cli ≥12）。默认关是因为多数
# 环境没有 mmdc —— 打开但环境不具备时会降级为只跑 L1 并留诊断，不会误判好图。
# 临时开启用 `ai-diagram --l2-validate`。
l2_validate = false
